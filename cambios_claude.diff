+}
+
+.repaso-btn-confianza.btn-again {
+  background: var(--fallo-fondo);
+  border-color: var(--fallo-fondo);
+  color: var(--fallo);
+}
+
+.repaso-btn-confianza.sugerido {
+  box-shadow: var(--anillo-again);
+}
+
+.repaso-ayuda kbd {
+  display: inline-grid;
+  place-items: center;
+  min-width: 22px;
+  height: 22px;
+  padding: 0 6px;
+  margin: 0 2px;
+  border-radius: var(--radius-sm);
+  background: var(--bg-tarjeta);
+  border: 1px solid var(--borde);
+  border-bottom-width: 2px;
+  font-size: var(--text-rem-75);
+  font-weight: var(--weight-extrabold);
+  color: var(--texto-principal);
+}
+
+.repaso-aviso-nube {
+  text-align: center;
+  font-size: var(--text-rem-82);
+  font-weight: var(--weight-semibold);
+  color: var(--aviso);
+  background: var(--aviso-fondo);
+  border: 1px solid var(--aviso-fondo);
+  border-radius: var(--radius-xl);
+  padding: 10px 14px;
+}
+
+.repaso-spinner {
+  width: 36px;
+  height: 36px;
+  border-radius: var(--radius-circulo);
+  border: 4px solid var(--borde);
+  border-top-color: var(--primario);
+  animation: spin 0.8s linear infinite;
+}
+
+/* ---------- Pantalla final ---------- */
+.repaso-app > .repaso-final {
+  margin: auto;
+  width: calc(100% - 32px);
+  max-width: 560px;
+  background: var(--bg-tarjeta);
+  border: 1px solid var(--borde);
+  border-radius: var(--radius-6xl);
+  box-shadow: var(--sombra-elevada);
+  padding: 36px 28px 30px;
+  text-align: center;
+  animation: slideUpFade 380ms var(--ease) both;
+}
+
+.repaso-final-icono {
+  width: 72px;
+  height: 72px;
+  margin: 0 auto 16px;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius-circulo);
+  background: var(--acierto-fondo);
+  color: var(--primario);
+  font-size: var(--text-rem-200);
+  font-weight: var(--weight-extrabold);
+  animation: pop 520ms var(--ease) 120ms both;
+}
+
+.repaso-final h2 {
+  font-size: var(--text-rem-150);
+  font-weight: var(--weight-extrabold);
+  letter-spacing: -0.02em;
+  color: var(--texto-principal);
+  margin-bottom: 8px;
+}
+
+.repaso-final-sub {
+  color: var(--texto-secundario);
+  font-size: var(--text-rem-95);
+  margin: 8px 0;
+}
+
+.repaso-racha-final {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  margin: 6px 0 4px;
+  padding: 6px 14px;
+  border-radius: var(--radius-full);
+  background: var(--aviso-fondo);
+  border: 1px solid var(--aviso-fondo);
+  color: var(--aviso);
+  font-weight: var(--weight-extrabold);
+  font-size: var(--text-rem-90);
+}
+
+.repaso-resumen-item {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 12px 6px;
+  border-radius: var(--radius-2xl);
+}
+
+.repaso-resumen-item strong {
+  font-size: var(--text-rem-150);
+  font-weight: var(--weight-extrabold);
+  line-height: 1.1;
+}
+
+.repaso-resumen-item span {
+  font-size: var(--text-rem-72);
+  font-weight: var(--weight-bold);
+}
+
+.repaso-btn-volver,
+.repaso-btn-secundario {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  min-height: 50px;
+  padding: 12px 26px;
+  margin-top: 14px;
+  border-radius: var(--radius-2xl);
+  font-size: var(--text-rem-95);
+  font-weight: var(--weight-extrabold);
+  text-decoration: none !important;
+  transition: background-color 0.15s, transform 0.15s;
+}
+
+.repaso-btn-volver {
+  background: var(--primario);
+  color: var(--texto-inverso);
+}
+
+.repaso-btn-volver:hover {
+  background: var(--primario-hover);
+}
+
+.repaso-btn-volver kbd {
+  padding: 2px 8px;
+  border-radius: var(--radius-sm);
+  background: var(--tinte-claro-suave);
+  font-size: var(--text-rem-72);
+  font-weight: var(--weight-bold);
+}
+
+.repaso-btn-secundario {
+  display: flex;
+  background: var(--bg-tarjeta);
+  color: var(--primario);
+  border: 1.5px solid var(--primario);
+}
+
+.repaso-btn-secundario:hover {
+  background: var(--acierto-fondo);
+}
+
+.repaso-btn-volver:active,
+.repaso-btn-secundario:active {
+  transform: scale(0.98);
+}
+
+/* =====================================================================
+   ANIMACIONES
+   ===================================================================== */
+@keyframes slideInRight {
+  from { transform: translateX(24px); opacity: 0; }
+  to   { transform: translateX(0);    opacity: 1; }
+}
+
+@keyframes slideOutLeft {
+  from { transform: translateX(0);     opacity: 1; }
+  to   { transform: translateX(-24px); opacity: 0; }
+}
+
+@keyframes slideUpFade {
+  from { transform: translateY(16px); opacity: 0; }
+  to   { transform: translateY(0);    opacity: 1; }
+}
+
+@keyframes shake {
+  0%   { transform: translateX(0); }
+  20%  { transform: translateX(-6px); }
+  40%  { transform: translateX(6px); }
+  60%  { transform: translateX(-4px); }
+  80%  { transform: translateX(4px); }
+  100% { transform: translateX(0); }
+}
+
+@keyframes pulseOk {
+  0%   { transform: scale(1); }
+  40%  { transform: scale(1.015); }
+  100% { transform: scale(1); }
+}
+
+@keyframes pop {
+  0%   { transform: scale(1); }
+  40%  { transform: scale(1.35) rotate(-4deg); }
+  70%  { transform: scale(0.94); }
+  100% { transform: scale(1); }
+}
+
+@keyframes iconPop {
+  0%   { opacity: 0; transform: scale(0.3) rotate(-30deg); }
+  60%  { opacity: 1; transform: scale(1.2) rotate(6deg); }
+  100% { opacity: 1; transform: scale(1) rotate(0); }
+}
+
+@keyframes spin {
+  to { transform: rotate(360deg); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .repaso-spinner {
+      animation-duration: 1.2s !important;
+      animation-iteration-count: infinite !important;
+    }
+
+  *,
+  *::before,
+  *::after {
+      animation-duration: 0.01ms !important;
+      animation-delay: 0s !important;
+      transition-duration: 0.01ms !important;
+      transition-delay: 0s !important;
+    }
+}
+
+/* =====================================================================
+   RESPONSIVE
+   ===================================================================== */
+@media (max-width: 767px) {
+  .pregunta-item {
+      grid-template-columns: minmax(0, 1fr);
+      padding: 18px 16px;
+    }
+
+  .repaso-combo {
+      min-width: 58px;
+      padding: 0 10px;
+    }
+
+  .repaso-tarjeta {
+      padding: 18px 16px 20px;
+      border-radius: var(--radius-4xl);
+    }
+
+  .repaso-opcion {
+      padding: 12px 14px;
+      font-size: var(--text-rem-100);
+    }
+
+  .repaso-confianza {
+      padding: 16px 14px 16px;
+      border-radius: var(--radius-4xl);
+    }
+
+  .repaso-btn-confianza.btn-again {
+      grid-column: 1 / -1;
+      min-height: 54px;
+      margin-top: 6px;
+    }
+}
+
+/* =====================================================================
+   Repaso · sugerencia de confianza por tiempo, fecha de repaso y resumen de tiempos
+   (no hay ningún contador de tiempo visible durante la tarjeta)
+   ===================================================================== */
+.repaso-sugerencia {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 6px 10px;
+  margin: -4px 0 14px;
+  font-size: var(--text-rem-82);
+  font-weight: var(--weight-semibold);
+  color: var(--texto-secundario);
+}
+
+.repaso-sugerencia-tag {
+  padding: 3px 10px;
+  border-radius: var(--radius-full);
+  font-size: var(--text-rem-74);
+  font-weight: var(--weight-extrabold);
+  background: var(--borde);
+  color: var(--texto-principal);
+}
+
+.repaso-sugerencia.nivel-easy .repaso-sugerencia-tag   { background: var(--acierto-fondo); color: var(--primario-hover); }
+
+.repaso-sugerencia.nivel-medium .repaso-sugerencia-tag { background: var(--info-fondo);  color: var(--info-oscuro); }
+
+.repaso-sugerencia.nivel-hard .repaso-sugerencia-tag   { background: var(--aviso-fondo); color: var(--aviso); }
+
+.repaso-sugerencia.nivel-again .repaso-sugerencia-tag  { background: var(--fallo-fondo);  color: var(--fallo); }
+
+/* Anillo del botón sugerido con el color de su nivel (again conserva el rojo de arriba) */
+.repaso-btn-confianza.btn-hard.sugerido   { box-shadow: var(--anillo-hard); }
+
+.repaso-btn-confianza.btn-medium.sugerido { box-shadow: var(--anillo-medium); }
+
+.repaso-btn-confianza.btn-easy.sugerido   { box-shadow: var(--anillo-easy); }
+
+.repaso-btn-fecha {
+  font-size: var(--text-rem-70);
+  font-weight: var(--weight-semibold);
+  opacity: 0.7;
+  text-transform: capitalize;
+}
+
+.repaso-tiempo-item {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 11px 6px;
+  border-radius: var(--radius-2xl);
+  background: var(--bg-suave);
+  border: 1px solid var(--borde);
+}
+
+.repaso-tiempo-item strong {
+  font-size: var(--text-rem-120);
+  font-weight: var(--weight-extrabold);
+  line-height: 1.1;
+  color: var(--texto-principal);
+  font-variant-numeric: tabular-nums;
+}
+
+.repaso-tiempo-item span {
+  font-size: var(--text-rem-74);
+  font-weight: var(--weight-semibold);
+  color: var(--texto-secundario);
+}
+
+.repaso-tiempo-item.limite strong { color: var(--texto-secundario); }
+
+.repaso-tiempos-barra {
+  height: 6px;
+  margin-top: 12px;
+  border-radius: var(--radius-full);
+  background: var(--borde);
+  overflow: hidden;
+}
+
+.repaso-tiempos-relleno {
+  height: 100%;
+  border-radius: var(--radius-full);
+  background: var(--primario);
+}
+
+.repaso-tiempos-mejora {
+  margin-top: 12px;
+  padding: 9px 12px;
+  border-radius: var(--radius-xl);
+  background: var(--bg-suave);
+  font-size: var(--text-rem-85);
+  font-weight: var(--weight-bold);
+  color: var(--texto-secundario);
+}
+
+.repaso-tiempos-mejora.hay-mejora {
+  background: var(--acierto-fondo);
+  color: var(--primario-hover);
+}
+
+.repaso-tiempos-nota {
+  margin-top: 8px;
+  font-size: var(--text-rem-78);
+  color: var(--texto-secundario);
+}
+
+.repaso-categoria {
+  padding: 4px 10px;
+  border-radius: var(--radius-full);
+  background: var(--borde);
+  color: var(--texto-secundario);
+  font-size: var(--text-rem-70);
+  font-weight: var(--weight-bold);
+  letter-spacing: 0.06em;
+  line-height: 1.2;
+}
+
+.repaso-debil-item {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 84px auto;
+  align-items: center;
+  gap: 10px;
+  padding: 9px 12px;
+  border-radius: var(--radius-xl);
+  background: var(--bg-suave);
+  border: 1px solid var(--borde);
+  font-size: var(--text-rem-85);
+}
+
+.repaso-debil-nombre {
+  font-weight: var(--weight-bold);
+  color: var(--texto-principal);
+}
+
+.repaso-debil-barra {
+  height: 6px;
+  border-radius: var(--radius-full);
+  background: var(--borde);
+  overflow: hidden;
+}
+
+.repaso-debil-barra > span {
+  display: block;
+  height: 100%;
+  border-radius: var(--radius-full);
+  background: var(--fallo);
+}
+
+.repaso-debil-pct {
+  font-size: var(--text-rem-75);
+  font-weight: var(--weight-bold);
+  color: var(--fallo);
+  white-space: nowrap;
+}
+
+@media (max-width: 480px) {
+  .repaso-debil-item { grid-template-columns: minmax(0, 1fr) auto; }
+
+  .repaso-debil-barra { display: none; }
+}
